{
  "name": "oms-e2e-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation suite for the OMS REST API and its web UI",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:integration": "playwright test --project=chromium tests/integration",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
